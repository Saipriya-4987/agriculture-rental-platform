# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Database Connection (Neon / Supabase / Render / Local Postgres)
DATABASE_URL=postgresql://username:password@hostname:5432/agrirent?sslmode=require

# JWT Authentication Secret (Must be strong and secure in production)
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters

# CORS Configuration - Allowed Frontend Origins
# Supports comma-separated list of allowed origins or single Vercel deployment URL
FRONTEND_URL=https://your-app.vercel.app
CORS_ORIGIN=https://your-app.vercel.app
