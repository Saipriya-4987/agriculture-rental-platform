# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Database Connection (Neon / Supabase / Render / Local Postgres)
# Used by the application server at runtime. NEVER used by tests.
DATABASE_URL=postgresql://username:password@hostname:5432/agrirent?sslmode=require

# ── TEST DATABASE ──────────────────────────────────────────────────────────────
# Separate connection string for the automated test suite (npm test).
# Do NOT set this here in .env — set it in backend/.env.test instead.
# Tests will refuse to start if TEST_DATABASE_URL is absent or if the host
# matches a known Neon production domain (neon.tech / neondb.io).
# Example: TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agrirent_test
# (See backend/tests/README.md for full setup instructions.)
# TEST_DATABASE_URL=postgresql://localhost:5432/agrirent_test

# JWT Authentication Secret (Must be strong and secure in production)
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters

# CORS Configuration - Allowed Frontend Origins
# Supports comma-separated list of allowed origins or single Vercel deployment URL
FRONTEND_URL=https://your-app.vercel.app
CORS_ORIGIN=https://your-app.vercel.app
