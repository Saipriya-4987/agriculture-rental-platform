# AgriRent Frontend Environment Variables
# In production on Vercel, set this to your deployed backend API URL (e.g. on Render/Railway)
# Example: https://agrirent-api.onrender.com/api
VITE_API_URL=http://localhost:3000/api

# Cloudinary Unsigned Image Upload (Required for equipment photo upload)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
